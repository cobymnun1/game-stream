{
  "name": "@basehack/protocol",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "WASM build of moonlight-common-c for production use",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "types": "./src/index.ts",
  "scripts": {
    "build": "pnpm run build:types && pnpm run build:wasm",
    "build:types": "tsc -p tsconfig.build.json",
    "build:wasm": "cmake --build build --target moonlight",
    "configure": "emcmake cmake -B build -DCMAKE_BUILD_TYPE=Release .",
    "fetch:moonlight": "node scripts/fetch-moonlight-common-c.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf build dist vendor/moonlight-common-c"
  },
  "devDependencies": {
    "typescript": "^5.5.0"
  }
}
