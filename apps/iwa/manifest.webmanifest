{
  "name": "Moonlight Stream",
  "short_name": "Moonlight",
  "description": "Decentralized game streaming via Akash Network",
  "version": "0.1.0",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "fullscreen",
  "background_color": "#000000",
  "theme_color": "#000000",
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ],
  "permissions_policy": {
    "direct-sockets": ["self"],
    "cross-origin-isolated": ["self"]
  },
  "isolated_storage": true
}
