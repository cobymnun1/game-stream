PORT=4000

# Supabase or any Postgres — Project Settings → Database → Connection string
DATABASE_URL=postgresql://user:pass@host:5432/dbname

PRIVY_APP_ID=                          # console.privy.io
PRIVY_APP_SECRET=                      # console.privy.io
WORKER_SHARED_SECRET=                  # random string, shared with Next.js

# Akash
AKASH_RPC=https://rpc.akash.network:443
AKASH_GRPC=https://akash-grpc.polkachu.com:443
SUNSHINE_IMAGE=cobymnun/game-stream-container:latest
AKASH_AKT_USD_PRICE=                   # blank = fetch live from CoinGecko
AKASH_IP_LEASE_USD_PER_HOUR=0.5

# KMS — blank = use DEV_ENCRYPTION_KEY (dev only)
AWS_REGION=us-east-1
AWS_KMS_KEY_ID=
DEV_ENCRYPTION_KEY=dev-32-byte-key-change-in-prod!!

# Squid
SQUID_INTEGRATOR_ID=
