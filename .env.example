# Copy to .env and fill in. .env is gitignored — never commit real secrets.

# ── Web (Next.js) ──────────────────────────────────────────────
NEXT_PUBLIC_PRIVY_APP_ID=          # console.privy.io
NEXT_PUBLIC_WORKER_URL=http://localhost:4000
WORKER_URL=http://localhost:4000
WORKER_SHARED_SECRET=              # random string, shared with the worker

# ── Worker ─────────────────────────────────────────────────────
PORT=4000
# Supabase or any Postgres — Project Settings → Database → Connection string (URI).
# Prefer "Direct connection" or "Session pooler" for the long-running worker.
# "Transaction pooler" (port 6543) works too; the worker disables prepared statements for it.
DATABASE_URL=postgresql://user:pass@host:5432/dbname
PRIVY_APP_ID=                      # console.privy.io
PRIVY_APP_SECRET=                  # console.privy.io
WORKER_SHARED_SECRET=              # must match the value above

# ── Akash ──────────────────────────────────────────────────────
AKASH_RPC=https://rpc.akash.network:443
AKASH_GRPC=https://akash-grpc.polkachu.com:443
SUNSHINE_IMAGE=ghcr.io/<owner>/game-stream:latest
AKASH_AKT_USD_PRICE=               # blank = fetch live from CoinGecko
AKASH_IP_LEASE_USD_PER_HOUR=0.5
# Funded Akash wallet used for demo deploys (12/24-word mnemonic). Keep secret.
DEMO_AKASH_MNEMONIC=

# ── KMS (production) — blank = use DEV_ENCRYPTION_KEY (dev only) ─
AWS_REGION=us-east-1
AWS_KMS_KEY_ID=
DEV_ENCRYPTION_KEY=dev-32-byte-key-change-in-prod!!

# ── Squid ──────────────────────────────────────────────────────
SQUID_INTEGRATOR_ID=
