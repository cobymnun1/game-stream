# Web (Next.js)
NEXT_PUBLIC_PRIVY_APP_ID=
# Privy dashboard: enable Discord/Twitter under Login methods before adding them
# to loginMethods in apps/web/components/providers/PrivyProvider.tsx
NEXT_PUBLIC_WORKER_URL=http://localhost:4000
WORKER_URL=http://localhost:4000
WORKER_SHARED_SECRET=dev-secret-change-me

# Worker
PORT=4000
# Supabase: open your project → click "Connect" (top of dashboard) → Connection string
# Pick "Direct connection" or "Session pooler" for this long-running worker.
# Transaction pooler (port 6543) also works; the worker disables prepared statements for it.
# Replace [YOUR-PASSWORD] with your database password (reset under Project Settings → Database if needed).
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[project-ref].supabase.co:5432/postgres
PRIVY_APP_ID=
PRIVY_APP_SECRET=
WORKER_SHARED_SECRET=dev-secret-change-me

# Akash
AKASH_RPC=https://rpc.akash.network:443
AKASH_GRPC=https://akash-grpc.polkachu.com:443
SUNSHINE_IMAGE=cobymnun/sunshine-stream:latest
AKASH_AKT_USD_PRICE=
AKASH_IP_LEASE_USD_PER_HOUR=0.5

# KMS (production) — omit for dev mode (uses DEV_ENCRYPTION_KEY)
AWS_REGION=us-east-1
AWS_KMS_KEY_ID=
DEV_ENCRYPTION_KEY=dev-32-byte-key-change-in-prod!!

# Squid
SQUID_INTEGRATOR_ID=
